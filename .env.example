# LLM provider — openai | gemini | claude (openai/gemini는 OpenAI 호환 공용)
LLM_PROVIDER=openai
# ↓↓↓ 여기에 API 키 입력 (openai면 OpenAI 키 sk-...)
LLM_API_KEY=
# 모델 (빈 값이면 provider 기본: openai=gpt-4o-mini / gemini=gemini-2.0-flash / claude=claude-sonnet-4-6)
LLM_MODEL=gpt-4o
STT_PROVIDER=deepgram
STT_API_KEY=
SUPABASE_DB_URL=            # pgvector 코퍼스 조회용
